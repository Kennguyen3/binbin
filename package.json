    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "postinstall": "patch-package",
    "android:dev": "adb reverse tcp:8081 tcp:8081 && cd android && ./gradlew :app:installDevDebug && adb shell am start -n com.binbincustomer/.MainActivity",
    "android:gp:debug": "adb reverse tcp:8081 tcp:8081 && cd android && ./gradlew :app:installGooglePlayDebug && adb shell am start -n com.binbincustomer/.MainActivity",
    "android:clean": "cd android && ./gradlew clean",
    "android:release": "cd android && ./gradlew :app:assembleGooglePlayRelease",
    "metro": "react-native start --reset-cache",
    "clean": "rm -f node_modules/react-native-config/ios/ReactNativeConfig/GeneratedDotEnv.m",
    "i18n:translate": "node scripts/autotranslate-locales.mjs",
    "i18n:translate:all": "node scripts/autotranslate-locales.mjs --all",
    "i18n:sync": "node scripts/sync-locales.mjs"
  },
